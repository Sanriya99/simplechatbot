# Copy this file to .env and fill in the values.

# Where Open WebUI is running
OPENWEBUI_URL=http://localhost:8080

# Open WebUI API key: Settings -> Account -> API Keys
OPENWEBUI_API_KEY=

# Optional: model id to use (e.g. gpt-4o-mini or your Azure deployment name).
# Leave empty to use the first model Open WebUI returns.
VITE_DEFAULT_MODEL=
